rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read-only study materials content
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if false;
    }
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false;
    }
    match /flashcards/{cardId} {
      allow read: if true;
      allow write: if false;
    }
    match /workedAnswers/{answerId} {
      allow read: if true;
      allow write: if false;
    }

    // User-specific progress and streak data: only owner can read and write
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard: public read, owner write
    match /leaderboard/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Student issue & content feedback: anyone can submit, authenticated read/update
    match /feedback/{feedbackId} {
      allow create: if true;
      allow read, update: if request.auth != null;
    }

    // Privacy-respecting aggregate usage analytics
    match /analytics/{docId} {
      allow read, write: if true;
    }
  }
}
